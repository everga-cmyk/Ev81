import micropip
await micropip.install('rebound')
await micropip.install('matplotlib')
await micropip.install('numpy')

import rebound
import numpy as np
import matplotlib.pyplot as plt

print("=" * 70)
print("SIMULAZIONE DEL SISTEMA SOLARE CON REBOUND")
print("=" * 70)

# Creazione della simulazione
sim = rebound.Simulation()
sim.units = ('AU', 'yr', 'Msun')  # Unità astronomiche, anni, masse solari

# Aggiunta dei corpi celesti (dati NASA/JPL)
print("\n📍 Aggiunta dei corpi celesti...")
print("-" * 70)

# Sole
sim.add(m=1.0)  # 1 massa solare
print("☉ Sole - massa: 1.0 M☉")

# Mercurio
sim.add(m=1.66e-7, a=0.387, e=0.206, inc=7.0*np.pi/180, Omega=48.3*np.pi/180, 
        omega=29.1*np.pi/180, f=0)
print("☿ Mercurio - a: 0.387 AU, e: 0.206")

# Venere
sim.add(m=2.45e-6, a=0.723, e=0.007, inc=3.4*np.pi/180, Omega=76.7*np.pi/180,
        omega=54.9*np.pi/180, f=0)
print("♀ Venere - a: 0.723 AU, e: 0.007")

# Terra
sim.add(m=3.0e-6, a=1.0, e=0.017, inc=0.0, Omega=0.0, omega=114.2*np.pi/180, f=0)
print("🌍 Terra - a: 1.0 AU, e: 0.017")

# Marte
sim.add(m=3.23e-7, a=1.524, e=0.093, inc=1.85*np.pi/180, Omega=49.6*np.pi/180,
        omega=286.5*np.pi/180, f=0)
print("♂ Marte - a: 1.524 AU, e: 0.093")

# Giove
sim.add(m=9.55e-4, a=5.203, e=0.049, inc=1.3*np.pi/180, Omega=100.5*np.pi/180,
        omega=273.9*np.pi/180, f=0)
print("♃ Giove - a: 5.203 AU, e: 0.049")

# Saturno
sim.add(m=2.86e-4, a=9.537, e=0.057, inc=2.5*np.pi/180, Omega=113.7*np.pi/180,
        omega=339.4*np.pi/180, f=0)
print("♄ Saturno - a: 9.537 AU, e: 0.057")

# Urano
sim.add(m=4.37e-5, a=19.191, e=0.046, inc=0.8*np.pi/180, Omega=74.0*np.pi/180,
        omega=96.5*np.pi/180, f=0)
print("♅ Urano - a: 19.191 AU, e: 0.046")

# Nettuno
sim.add(m=5.15e-5, a=30.069, e=0.009, inc=1.8*np.pi/180, Omega=131.8*np.pi/180,
        omega=273.2*np.pi/180, f=0)
print("♆ Nettuno - a: 30.069 AU, e: 0.009")

print(f"\n✅ Totale corpi celesti: {sim.N}")

# Sistema di riferimento centrato sul baricentro
sim.move_to_com()

# Configurazione integratore
sim.integrator = "ias15"  # Integratore ad alta precisione
sim.dt = 0.01  # Passo temporale in anni

print("\n⚙️ Configurazione simulazione:")
print(f"   Integratore: {sim.integrator}")
print(f"   Passo temporale: {sim.dt} anni")
print(f"   Sistema di riferimento: Baricentro")

# Integrazione della simulazione
print("\n🚀 Avvio integrazione numerica...")
print("-" * 70)

n_years = 100  # Numero di anni da simulare
n_steps = 1000  # Numero di passi temporali
times = np.linspace(0, n_years, n_steps)

# Array per memorizzare le posizioni
positions = {i: {'x': [], 'y': [], 'z': []} for i in range(sim.N)}

# Nomi dei pianeti
planet_names = ['Sole', 'Mercurio', 'Venere', 'Terra', 'Marte', 
                'Giove', 'Saturno', 'Urano', 'Nettuno']

# Integrazione
for i, t in enumerate(times):
    sim.integrate(t)
    for j in range(sim.N):
        p = sim.particles[j]
        positions[j]['x'].append(p.x)
        positions[j]['y'].append(p.y)
        positions[j]['z'].append(p.z)
    
    if i % 100 == 0:
        print(f"Progresso: {i}/{n_steps} passi ({100*i/n_steps:.1f}%)")

print(f"✅ Integrazione completata: {n_years} anni simulati")

# Calcolo manuale dell'energia totale
def calculate_energy_manual(sim):
    E_kin = 0.0
    E_pot = 0.0
    particles = sim.particles
    
    # Energia cinetica
    for p in particles:
        E_kin += 0.5 * p.m * (p.vx**2 + p.vy**2 + p.vz**2)
    
    # Energia potenziale gravitazionale
    for i in range(len(particles)):
        for j in range(i+1, len(particles)):
            dx = particles[i].x - particles[j].x
            dy = particles[i].y - particles[j].y
            dz = particles[i].z - particles[j].z
            r = np.sqrt(dx**2 + dy**2 + dz**2)
            E_pot -= sim.G * particles[i].m * particles[j].m / r
    
    return E_kin + E_pot

# Calcolo manuale del momento angolare
def calculate_angular_momentum_manual(sim):
    Lx, Ly, Lz = 0.0, 0.0, 0.0
    for p in sim.particles:
        Lx += p.m * (p.y * p.vz - p.z * p.vy)
        Ly += p.m * (p.z * p.vx - p.x * p.vz)
        Lz += p.m * (p.x * p.vy - p.y * p.vx)
    return np.array([Lx, Ly, Lz])

print("\n📊 ANALISI CONSERVAZIONE ENERGIA E MOMENTO ANGOLARE")
print("-" * 70)
E0 = calculate_energy_manual(sim)
L0 = calculate_angular_momentum_manual(sim)
print(f"Energia iniziale: {E0:.10e} M☉·AU²·yr⁻²")
print(f"Momento angolare iniziale: {np.linalg.norm(L0):.10e} M☉·AU²·yr⁻¹")

# Energia e momento alla fine
E_final = calculate_energy_manual(sim)
L_final = calculate_angular_momentum_manual(sim)
print(f"\nEnergia finale: {E_final:.10e} M☉·AU²·yr⁻²")
print(f"Momento angolare finale: {np.linalg.norm(L_final):.10e} M☉·AU²·yr⁻¹")

delta_E = abs((E_final - E0) / E0)
delta_L = abs((np.linalg.norm(L_final) - np.linalg.norm(L0)) / np.linalg.norm(L0))
print(f"\nVariazione relativa energia: {delta_E:.10e}")
print(f"Variazione relativa momento angolare: {delta_L:.10e}")

# Calcolo manuale dell'energia totale
def calculate_energy_manual(sim):
    E_kin = 0.0
    E_pot = 0.0
    particles = sim.particles
    
    # Energia cinetica
    for p in particles:
        E_kin += 0.5 * p.m * (p.vx**2 + p.vy**2 + p.vz**2)
    
    # Energia potenziale gravitazionale
    for i in range(len(particles)):
        for j in range(i+1, len(particles)):
            dx = particles[i].x - particles[j].x
            dy = particles[i].y - particles[j].y
            dz = particles[i].z - particles[j].z
            r = np.sqrt(dx**2 + dy**2 + dz**2)
            E_pot -= sim.G * particles[i].m * particles[j].m / r
    
    return E_kin + E_pot

# Calcolo manuale del momento angolare
def calculate_angular_momentum_manual(sim):
    Lx, Ly, Lz = 0.0, 0.0, 0.0
    for p in sim.particles:
        Lx += p.m * (p.y * p.vz - p.z * p.vy)
        Ly += p.m * (p.z * p.vx - p.x * p.vz)
        Lz += p.m * (p.x * p.vy - p.y * p.vx)
    return np.array([Lx, Ly, Lz])

print("\n📊 ANALISI CONSERVAZIONE ENERGIA E MOMENTO ANGOLARE")
print("-" * 70)
E0 = calculate_energy_manual(sim)
L0 = calculate_angular_momentum_manual(sim)
print(f"Energia iniziale: {E0:.10e} M☉·AU²·yr⁻²")
print(f"Momento angolare iniziale: {np.linalg.norm(L0):.10e} M☉·AU²·yr⁻¹")

# Visualizzazione
print("\n📈 GENERAZIONE GRAFICI...")
print("-" * 70)

# Colori e dimensioni dei pianeti
colors = ['#FDB813', '#8C7853', '#FFC649', '#4169E1', '#CD5C5C', 
          '#DAA520', '#F4A460', '#4FD0E0', '#4169E1']
sizes = [200, 30, 50, 50, 40, 150, 120, 80, 80]

# Figura con 3 subplot
fig = plt.figure(figsize=(18, 6))

# 1. Vista XY (Piano dell'eclittica)
ax1 = fig.add_subplot(131)
for i in range(sim.N):
    x = positions[i]['x']
    y = positions[i]['y']
    ax1.plot(x, y, '-', color=colors[i], linewidth=1, alpha=0.6, label=planet_names[i])
    ax1.scatter(x[-1], y[-1], s=sizes[i], color=colors[i], edgecolors='black', linewidth=1)

ax1.set_xlabel('X [AU]', fontsize=11, fontweight='bold')
ax1.set_ylabel('Y [AU]', fontsize=11, fontweight='bold')
ax1.set_title('Vista Piano Eclittica (XY)', fontsize=12, fontweight='bold')
ax1.grid(True, alpha=0.3)
ax1.set_aspect('equal')
ax1.legend(loc='upper right', fontsize=8)

# 2. Sistema Solare Interno (zoom)
ax2 = fig.add_subplot(132)
for i in range(5):  # Solo fino a Marte
    x = positions[i]['x']
    y = positions[i]['y']
    ax2.plot(x, y, '-', color=colors[i], linewidth=1.5, alpha=0.7, label=planet_names[i])
    ax2.scatter(x[-1], y[-1], s=sizes[i]*2, color=colors[i], edgecolors='black', linewidth=1.5)

ax2.set_xlabel('X [AU]', fontsize=11, fontweight='bold')
ax2.set_ylabel('Y [AU]', fontsize=11, fontweight='bold')
ax2.set_title('Sistema Solare Interno (Zoom)', fontsize=12, fontweight='bold')
ax2.grid(True, alpha=0.3)
ax2.set_aspect('equal')
ax2.legend(loc='upper right', fontsize=9)
ax2.set_xlim(-2, 2)
ax2.set_ylim(-2, 2)

# 3. Vista 3D
ax3 = fig.add_subplot(133, projection='3d')
for i in range(1, sim.N):  # Escludi il Sole per scala migliore
    x = positions[i]['x']
    y = positions[i]['y']
    z = positions[i]['z']
    ax3.plot(x, y, z, '-', color=colors[i], linewidth=1, alpha=0.6, label=planet_names[i])
    ax3.scatter(x[-1], y[-1], z[-1], s=sizes[i], color=colors[i], edgecolors='black', linewidth=1)

# Sole al centro
ax3.scatter(0, 0, 0, s=sizes[0], color=colors[0], edgecolors='orange', linewidth=2, label='Sole')

ax3.set_xlabel('X [AU]', fontsize=10, fontweight='bold')
ax3.set_ylabel('Y [AU]', fontsize=10, fontweight='bold')
ax3.set_zlabel('Z [AU]', fontsize=10, fontweight='bold')
ax3.set_title('Vista 3D', fontsize=12, fontweight='bold')
ax3.legend(loc='upper right', fontsize=7)

plt.tight_layout()
plt.show()

print("✅ Grafici generati con successo!")

# Informazioni finali sui periodi orbitali
print("\n🌍 PERIODI ORBITALI SIMULATI")
print("-" * 70)
orbital_periods = [0, 0.24, 0.62, 1.0, 1.88, 11.86, 29.46, 84.01, 164.79]  # anni
for i in range(1, sim.N):
    n_orbits = n_years / orbital_periods[i]
    print(f"{planet_names[i]}: {orbital_periods[i]:.2f} anni/orbita → {n_orbits:.1f} orbite completate")

print("\n" + "=" * 70)
print("SIMULAZIONE COMPLETATA")
print("=" * 70)
